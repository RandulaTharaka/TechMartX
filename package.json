{
  "name": "techmartx",
  "version": "1.0.0",
  "description": "e-commerce app built with MERN",
  "homepage": "https://github.com/RandulaTharaka/TechMartX#readme",
  "bugs": {
    "url": "https://github.com/RandulaTharaka/TechMartX/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RandulaTharaka/TechMartX.git"
  },
  "license": "MIT",
  "author": "Randula Tharaka",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d",
    "build": "npm install --legacy-peer-deps && npm install --prefix frontend --legacy-peer-deps && npm run build --prefix frontend"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "mongoose": "^8.15.0",
    "multer": "^2.0.2",
    "react-router-bootstrap": "^0.26.3",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10"
  }
}
